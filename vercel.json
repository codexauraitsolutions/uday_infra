{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "api/s3-presign.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/s3-presign", "dest": "/api/s3-presign.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
